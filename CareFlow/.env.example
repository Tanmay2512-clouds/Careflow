# MongoDB Atlas connection string (Prisma MongoDB provider).
# Replace every placeholder with your Atlas cluster and database credentials.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careflow?retryWrites=true&w=majority"

# Secret used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-unique-random-secret-at-least-32-bytes-long"
